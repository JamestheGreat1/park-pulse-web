{
  "name": "ParkPulse — Ride Watcher",
  "short_name": "ParkPulse",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#081426",
  "theme_color": "#081426",
  "description": "Watch Walt Disney World rides, crowd levels, and park hours, and get notified when a ride reopens or its posted wait drops below your target.",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "travel",
    "utilities"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "./assets/icons/icon-192.png?v=1.5.3-install-push",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png?v=1.5.3-install-push",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
