# ParkPulse 2.0 — staging Worker ONLY. Generated locally from this template.
# Never use the production database ID or re-enable cron before validation.
name = "parkpulse-api-staging"
main = "src/index.js"
compatibility_date = "2026-09-01"
preview_urls = false

# Retain staging cron invocation logs and console output in Workers Observability.
# This affects the staging Worker only; production logging remains unchanged.
[observability]
enabled = true

[observability.logs]
enabled = true
invocation_logs = true
head_sampling_rate = 1

[vars]
APP_URL = "https://parkpulse-staging.invalid/"
APP_ORIGIN = "https://parkpulse-staging.invalid"
VAPID_SUBJECT = "https://parkpulse-staging.invalid/"
STAGING_MODE = "true"
STAGING_ALLOW_PUSH = "false"
STAGING_PUSH_TEST_ONLY = "false"
STAGING_ENABLE_CRON = "false"
STAGING_HISTORY_ONLY = "false"
STAGING_LIVE_PROBE = "false"

[[d1_databases]]
binding = "DB"
database_name = "parkpulse-staging"
database_id = "__STAGING_D1_ID__"

# Explicitly clear any prior staging schedules when disabling collection.
[triggers]
crons = []
